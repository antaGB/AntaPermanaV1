---
import { Icon } from "astro-icon/components";
import { reader } from "../lib/reader";
import Badge from "./Badge.astro";

const projects = await reader.collections.projects.all();
console.log("projects found:", projects.length);
---

<section id="projects" class="scroll-mt-16 py-20">
    <div class="max-w-7xl mx-auto">
        <h2 data-reveal class="mb-14 text-4xl font-bold text-primary md:text-5xl">
            Selected work. <br />
            <span class="text-primary/80">Things I'm proud of.</span>
        </h2>

        <ol class="border-b border-primary/10">
            {
                projects.map(({ slug, entry }, i) => (
                    <li data-reveal="left" data-reveal-delay="0.5" class="group relative border-t border-primary/10">
                        <article class="grid grid-cols-[6.5rem_1fr] items-center gap-x-5 py-6 md:grid-cols-[3rem_11rem_1fr_auto] md:gap-x-8 md:py-8">
                            <!-- Number (desktop only) -->
                            <span class="hidden text-sm font-semibold text-neutral-400 md:block">
                                {String(i + 1).padStart(2, "0")}
                            </span>

                            <!-- Thumbnail -->
                            <div class="overflow-hidden rounded-xl shadow-sm">
                                <img
                                    src={entry.image}
                                    alt=""
                                    loading={i < 2 ? "eager" : "lazy"}
                                    transition:name={`project-${slug}`}
                                    class="aspect-3/2 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none"
                                />
                            </div>

                            <!-- Text -->
                            <div class="min-w-0">
                                <h3 class="text-xl font-bold text-primary md:text-3xl">
                                <!-- Stretched link: the whole row is clickable -->
                                <a
                                    href={`/projects/${slug}`}
                                    class="after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                                >
                                    {entry.title}
                                </a>
                            </h3>

                            <p class="mt-1 line-clamp-2 text-neutral-500 md:mt-2 md:max-w-xl">
                                {entry.excerpt}
                            </p>

                            <div class="mt-3 flex flex-wrap items-center gap-x-2">
                                {entry.tools.map((tool) => (
                                    <Badge icon={tool.icon} name={tool.name} class="text-xs font-semibold text-neutral-400" />
                                ))}
                            </div>
                                <div class="relative z-10 mt-3 flex gap-3">
                                    {entry.githubUrl && (
                                        <a
                                            href={entry.githubUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label={`${entry.title} on GitHub`}
                                            class="-m-1.5 p-1.5 text-neutral-400 transition duration-200 hover:scale-110 hover:text-primary"
                                        >
                                            <Icon name="simple-icons:github" class="size-6" />
                                        </a>
                                    )}
                                    {entry.siteUrl && (
                                        <a
                                            href={entry.siteUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label={`Visit ${entry.title} website`}
                                            class="-m-1.5 p-1.5 text-neutral-400 transition duration-200 hover:scale-110 hover:text-primary"
                                        >
                                            <Icon name="lucide:globe" class="size-6" />
                                        </a>
                                    )}
                                </div>
                            </div>

                            <!-- Arrow (desktop only) -->
                            <span class="hidden size-12 items-center justify-center rounded-full border border-primary/15 text-primary transition-all duration-300 group-hover:border-primary group-hover:bg-primary group-hover:text-paper md:flex">
                                <Icon
                                    name="lucide:arrow-up-right"
                                    class="size-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                />
                            </span>
                        </article>
                    </li>
                ))
            }
        </ol>
    </div>
</section>