---
import Badge from "./Badge.astro";

// Placeholder data: replace with your own
const jobs = [
  {
    period: "2025 — Present",
    current: true,
    company: "Company or client name",
    url: "https://example.com",
    role: "Fullstack Web Developer",
    location: "Remote",
    summary:
      "One or two plain sentences about what you do there and what you're proud of.",
    highlights: [
      "Something you built or improved, and who it helped",
      "Another result, with a number if you have one",
    ],
    tools: [
      { name: "Laravel", icon: "laravel" },
      { name: "React", icon: "react" },
    ],
  },
  {
    period: "2024 — 2025",
    company: "Previous company",
    role: "Web Developer",
    location: "Bali, Indonesia",
    summary: "A short line about the role and what you learned.",
    highlights: ["Something you're proud of from this time"],
    tools: [{ name: "PHP", icon: "php" }],
  },
];
---

<section id="experience" class="scroll-mt-16 py-16 px-5">
  <div class="max-w-7xl mx-auto grid grid-cols-1 items-start gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
    <!-- Left: sticks while the list scrolls -->
    <div class="md:sticky md:top-28">
      <h2 data-reveal class="text-4xl font-bold text-primary lg:text-5xl font-heading">
        Where I've worked. <br />
        <span class="text-primary/80">Places I've learned a lot.</span>
      </h2>
    </div>

    <!-- Right: the list -->
    <ol class="ms-2 border-s border-primary/15">
      {
        jobs.map((job) => (
          <li data-reveal data-reveal-delay="0.5" class="group relative pb-14 ps-8 last:pb-0 md:ps-12">
            <span
              aria-hidden="true"
              class:list={[
                "absolute -start-[5.5px] top-2 flex size-2.5 rounded-full transition-transform duration-300 group-hover:scale-150",
                job.current
                  ? "bg-primary"
                  : "border border-primary/40 bg-paper",
              ]}
            >
              {job.current && (
                <span class="absolute -inset-1 animate-ping rounded-full bg-primary/30" />
              )}
            </span>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              <span class="font-semibold text-neutral-500">{job.period}</span>
              <span aria-hidden="true" class="h-px w-4 bg-primary/20" />
              <span class="text-neutral-400">{job.location}</span>
            </div>

            <h3 class="mt-3 text-2xl font-bold text-primary md:text-3xl">
              {job.role}
            </h3>
            <p class="mt-1 text-lg font-semibold text-neutral-500">
              {job.url ? (
                <a
                  href={job.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-primary/20 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
                >
                  {job.company}
                </a>
              ) : (
                job.company
              )}
            </p>

            <p class="mt-5 max-w-2xl leading-relaxed text-neutral-500">
              {job.summary}
            </p>

            {job.highlights?.length > 0 && (
              <ul class="mt-5 flex max-w-2xl flex-col gap-2">
                {job.highlights.map((item) => (
                  <li class="flex gap-3 leading-relaxed text-neutral-500">
                    <span
                      aria-hidden="true"
                      class="mt-2.5 h-px w-4 shrink-0 bg-primary/40"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {job.tools?.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {job.tools.map((tool) => (
                  <li>
                    <Badge name={tool.name} icon={tool.icon} variant="soft" />
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>