---
import { Icon } from "astro-icon/components";
import LinkButton from "./LinkButton.astro";

const links = [
  { label: "Home", href: "/" },
  { label: "Experience", href: "/#experience" },
  { label: "Projects", href: "/#projects" },
  { label: "Contact", href: "/#contact" },
];
---

<header
  id="navbar"
  transition:persist="navbar"
  class="group sticky top-0 z-50 border-b border-transparent bg-paper/80 backdrop-blur-md
         transition-colors duration-300
         data-[scrolled]:border-primary/10 group-data-[open]:bg-paper"
>
  <nav
    aria-label="Main"
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6"
  >
    <a href="/" class="text-lg font-bold text-primary">Anta Permana</a>

    <!-- Desktop -->
    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-semibold text-neutral-500 transition-colors duration-200 hover:text-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <LinkButton href="/#contact" size="sm">Contact</LinkButton>
      </li>
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-menu"
      class="relative flex size-10 items-center justify-center rounded-full text-primary transition-colors hover:bg-primary/10 md:hidden"
    >
      <Icon
        name="lucide:menu"
        class="absolute size-6 transition-all duration-200 group-data-[open]:rotate-90 group-data-[open]:opacity-0"
      />
      <Icon
        name="lucide:x"
        class="absolute size-6 -rotate-90 opacity-0 transition-all duration-200 group-data-[open]:rotate-0 group-data-[open]:opacity-100"
      />
    </button>
  </nav>

  <!-- Mobile menu: slides open by animating the grid row height -->
  <div
    id="nav-menu"
    inert
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out
           group-data-[open]:grid-rows-[1fr] md:hidden"
  >
    <div class="overflow-hidden">
      <ul class="flex flex-col gap-1 px-6 pb-6 pt-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-xl px-3 py-3 text-lg font-semibold text-primary transition-colors hover:bg-primary/5 active:bg-primary/10"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="px-3 pt-3">
          <LinkButton href="/#contact">Contact</LinkButton>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("navbar")!;
  const toggle = document.getElementById("nav-toggle")!;
  const menu = document.getElementById("nav-menu")!;

  function setOpen(open: boolean) {
    header.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    menu.toggleAttribute("inert", !open); // keeps hidden links out of tab order
  }

  toggle.addEventListener("click", () => {
    setOpen(!header.hasAttribute("data-open"));
  });

  // Capture phase on window, so it still runs when the anchor-scroll script
  // stops propagation. Closes on a menu link click or a click outside.
  window.addEventListener(
    "click",
    (e) => {
      const target = e.target as Element;
      if (target.closest("#nav-menu a") || !header.contains(target)) {
        setOpen(false);
      }
    },
    true,
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Close if the screen grows to desktop size while open
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });

  // The navbar persists across pages, so close the menu after each navigation
  document.addEventListener("astro:after-swap", () => setOpen(false));

  // Show a bottom border once the page has scrolled
  const onScroll = () => header.toggleAttribute("data-scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>